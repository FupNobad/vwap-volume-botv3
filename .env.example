# Optional public market-data configuration. No API key is needed for public OHLCV.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Safety: this project deliberately has no live order-submission path.
TRADING_MODE=paper
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT
TIMEFRAME=1h
RISK_FRACTION=0.0025
DAILY_LOSS_LIMIT=0.01
MAX_LEVERAGE=1
VOLUME_MULTIPLE=3.0
VOLUME_LOOKBACK_BARS=168
ATR_PERIOD=14
STOP_ATR_MULTIPLE=1.5
TAKE_PROFIT_R=2.0
TAKER_FEE_RATE=0.0005
SLIPPAGE_BPS=5
DB_PATH=vwapbot.sqlite3
LOG_LEVEL=INFO
